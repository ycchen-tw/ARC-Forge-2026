{
  "schema_version": 1,
  "concurrency": 55,
  "fence": "posix",
  "effort": "xhigh",
  "model_context_window": 120000,
  "auto_compact_token_limit": 90000,
  "output_token_budget": 100000,
  "task_wall_seconds": 10800,
  "max_sessions": 3,
  "min_resume_tokens": 10000,
  "prompts": "v2",
  "driver_config": {
    "model_input_modalities": "[\"text\",\"image\"]",
    "features.sglang_session_release": "true",
    "features.compaction_reuse_prefix": "true",
    "features.compaction_strip_analysis": "true",
    "model_providers.local.stream_max_retries": "12",
    "model_providers.local.request_max_retries": "12"
  },
  "process_data_max": "8G",
  "game_memory_max": "10G",
  "watchdog_headroom": "12G",
  "watchdog_cpu_seconds": 900,
  "oom_score_adj": 1000,
  "net_probe": "1.1.1.1:443",
  "uid_base": 31000,
  "budget_poll_seconds": 5,
  "heartbeat_seconds": 300,
  "keep_driver_home": true,
  "model_error_wait_seconds": 1800,
  "max_failures": 3,
  "note": "v2 = v1 + workspace helper arc.py (parsed grids, show/diff/render) and compact task.json (v1 tool outputs: task.json reads were 45% of 8.3k context tokens per task) + brief: check the test outputs against the rule before stopping (v1: 99 tasks pass every training pair, 80 fully correct). Harness fixes since v1: exact budget via proxy, near-zero budget = exhausted, transient codex reconnect is not a model error.",
  "network_namespace": true,
  "workspace_helper": true,
  "midpoint_reminder_tokens": null,
  "best_snapshot": false,
  "view": "text",
  "check_call_limit": null
}
