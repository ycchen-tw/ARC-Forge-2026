{
  "schema_version": 1,
  "concurrency": 55,
  "fence": "posix",
  "effort": "xhigh",
  "model_context_window": 150000,
  "auto_compact_token_limit": 140000,
  "output_token_budget": 100000,
  "task_wall_seconds": 10800,
  "max_sessions": 3,
  "min_resume_tokens": 10000,
  "prompts": "v2",
  "driver_config": {
    "model_input_modalities": "[\"text\",\"image\"]",
