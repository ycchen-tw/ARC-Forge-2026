{
  "schema_version": 1,
  "concurrency": 55,
  "fence": "posix",
  "effort": "xhigh",
  "model_context_window": 150000,
  "auto_compact_token_limit": 140000,
  "output_token_budget": 1000000,
  "task_wall_seconds": 14400,
  "max_sessions": 3,
  "min_resume_tokens": 10000,
  "prompts": "v3",
  "driver_config": {
    "model_input_modalities": "[\"text\",\"image\"]",
    "features.sglang_session_release": "true",
    "features.compaction_reuse_prefix": "true",
    "features.compaction_strip_analysis": "true",
    "model_providers.local.stream_max_retries": "12",
    "model_providers.local.request_max_retries": "12",
    "features.pre_compact_reminder": "true"
  },
  "process_data_max": "8G",
  "game_memory_max": "10G",
  "watchdog_headroom": "12G",
  "watchdog_cpu_seconds": 900,
  "oom_score_adj": 1000,
  "net_probe": "1.1.1.1:443",
  "uid_base": 31000,
  "budget_poll_seconds": 5,
  "heartbeat_seconds": 300,
  "keep_driver_home": true,
  "model_error_wait_seconds": 1800,
  "max_failures": 3,
  "note": "v6 = v5 without an output cap (user 2026-10-04: let every task run until the model stops by itself, to see the accuracy ceiling). Budget 1M is effectively unlimited; task_wall_seconds 4 h is the safety stop. Compaction stays at 140k / window 150k -- with no cap it is the only way past the 155k server context. Everything else = v5 (mid-run checkpoint at 65k, best_snapshot).",
  "network_namespace": true,
  "workspace_helper": true,
  "midpoint_reminder_tokens": 65000,
  "best_snapshot": true,
  "view": "text",
  "check_call_limit": null
}
