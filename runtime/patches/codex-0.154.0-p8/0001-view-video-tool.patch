+fn bmff_box(kind: &[u8; 4], body: &[u8]) -> Vec<u8> {
+    let mut out = (u32::try_from(body.len() + 8).unwrap()).to_be_bytes().to_vec();
+    out.extend_from_slice(kind);
+    out.extend_from_slice(body);
+    out
+}
+
+/// Smallest mp4 the video estimate reads: one video track with `frames` samples of
+/// `width` x `height` (tkhd v0 is 84 bytes, width/height last as 16.16 fixed point).
+fn mp4_data_url(frames: u32, width: u32, height: u32, padding: usize) -> (String, usize) {
+    let mut tkhd = vec![0u8; 76];
+    tkhd.extend_from_slice(&(width << 16).to_be_bytes());
+    tkhd.extend_from_slice(&(height << 16).to_be_bytes());
+    let mut hdlr = vec![0u8; 8];
+    hdlr.extend_from_slice(b"vide");
+    hdlr.extend_from_slice(&[0u8; 13]);
+    let mut stsz = vec![0u8; 8];
+    stsz.extend_from_slice(&frames.to_be_bytes());
+    stsz.extend((0..frames).flat_map(|_| 100u32.to_be_bytes()));
+    let stbl = bmff_box(b"stbl", &bmff_box(b"stsz", &stsz));
+    let minf = bmff_box(b"minf", &stbl);
+    let mdia = bmff_box(b"mdia", &[bmff_box(b"hdlr", &hdlr), minf].concat());
+    let trak = bmff_box(b"trak", &[bmff_box(b"tkhd", &tkhd), mdia].concat());
+    let mut bytes = bmff_box(b"ftyp", b"isom\0\0\x02\0isomiso2avc1mp41");
+    bytes.extend(bmff_box(b"moov", &trak));
+    bytes.extend(bmff_box(b"mdat", &vec![0x5a; padding]));
+    let payload = BASE64_STANDARD.encode(bytes);
+    let payload_len = payload.len();
+    (format!("data:video/mp4;base64,{payload}"), payload_len)
+}
+
+fn video_output_item(video_url: VideoUrl) -> ResponseItem {
+    ResponseItem::FunctionCallOutput {
+        id: None,
+        call_id: Some("call-video".to_string()),
+        name: None,
+        namespace: None,
+        output: FunctionCallOutputPayload::from_content_items(vec![
+            FunctionCallOutputContentItem::InputVideo { video_url },
+        ]),
+        internal_chat_message_metadata_passthrough: None,
+    }
+}
+
+#[test]
+fn video_data_url_is_estimated_from_its_mp4_header() {
+    // 23 frames of 384x384, the shape of an ARC-AGI-3 step recording: 12 temporal groups of
+    // 12x12 tokens (+16 markers each), whatever the file size.
+    let (url, payload_len) = mp4_data_url(/*frames*/ 23, /*width*/ 384, /*height*/ 384, 450_000);
+    let item = video_output_item(VideoUrl {
+        url,
+        max_frames: None,
+        max_tokens_per_frame: None,
+        fps: None,
+    });
+    let raw_len = serde_json::to_string(&item).unwrap().len() as i64;
+    let estimated = estimate_response_item_model_visible_bytes(&item);
+    let expected =
+        raw_len - payload_len as i64 + approx_bytes_for_tokens(/*tokens*/ 12 * (144 + 16)) as i64;
+    assert_eq!(estimated, expected);
+    assert!(estimate_item_token_count(&item) < 2_000);
+}
+
+#[test]
+fn video_estimate_ignores_the_frame_hints() {
+    // The Kaggle sglang spends tokens on every container frame whatever max_frames says,
+    // so the hints must not shrink the estimate: 66 frames -> 33 groups, 20x20 tokens each.
+    let (url, payload_len) = mp4_data_url(/*frames*/ 66, /*width*/ 640, /*height*/ 640, 0);
+    let item = video_output_item(VideoUrl {
+        url,
+        max_frames: Some(16),
+        max_tokens_per_frame: Some(300),
+        fps: None,
+    });
+    let raw_len = serde_json::to_string(&item).unwrap().len() as i64;
+    let estimated = estimate_response_item_model_visible_bytes(&item);
+    let expected =
+        raw_len - payload_len as i64 + approx_bytes_for_tokens(/*tokens*/ 33 * (400 + 16)) as i64;
+    assert_eq!(estimated, expected);
+}
+
+#[test]
+fn unreadable_video_keeps_its_raw_size() {
+    let item = video_output_item(VideoUrl {
+        url: format!("data:video/webm;base64,{}", BASE64_STANDARD.encode([0x1a, 0x45, 0xdf, 0xa3])),
+        max_frames: None,
+        max_tokens_per_frame: None,
+        fps: None,
+    });
+    let raw_len = serde_json::to_string(&item).unwrap().len() as i64;
+    assert_eq!(estimate_response_item_model_visible_bytes(&item), raw_len);
+}
