+/// Returns the base64 payload for inline video data URLs (`view_video`).
+fn parse_base64_video_data_url(url: &str) -> Option<&str> {
+    parse_base64_data_url(url, "video/")
+}
+
+// Video estimate, the `video_url` counterpart of the image and audio estimates above.
+// Counted at its raw serialized size, a video is base64 bytes / 4 = file bytes / 3
+// tokens: a 450 KB lossless 384 px recording came out at ~152k tokens while the server
+// spends ~1.7k on it, and the post-sampling check (`get_total_token_usage`) compacted on
+// that estimate right after the tool call.
+//
+// The cost on Qwen-VL style servers (sglang) is: frames are merged in temporal groups of
+// 2, each group costs one token per 32x32 pixel block (16 px patches, 2x2 merge), plus a
+// few tokens of timestamp and vision start/end markers. The frame count and display size
+// come from the ISO-BMFF header (mp4/mov), so nothing is decoded. The tool call's
+// `max_frames` / `max_tokens_per_frame` hints are deliberately NOT applied: on the Kaggle
+// sglang the cost follows the container's frame count whatever `max_frames` says (66
+// frames with max_frames=16 cost 33 groups, 5,056 tokens), so capping by the hint would
+// under-estimate. Using the container's sample count over-estimates when a server does
+// sample fewer frames (e.g. by fps), which is the safe direction for a compaction trigger.
+const VIDEO_FRAMES_PER_TEMPORAL_GROUP: i64 = 2;
+const VIDEO_PIXELS_PER_TOKEN_SIDE: i64 = 32;
+/// Timestamp text plus vision start/end per temporal group; measured 9-10 on sglang 0.5.20
+/// with Qwen3.8 (`<0.2 seconds><|vision_start|>...<|vision_end|>`), rounded up.
+const VIDEO_TEMPORAL_GROUP_OVERHEAD_TOKENS: i64 = 16;
+const VIDEO_ESTIMATE_CACHE_SIZE: usize = 32;
+
+static VIDEO_ESTIMATE_CACHE: LazyLock<BlockingLruCache<[u8; 20], Option<VideoGeometry>>> =
+    LazyLock::new(|| {
+        BlockingLruCache::new(
+            NonZeroUsize::new(VIDEO_ESTIMATE_CACHE_SIZE).unwrap_or(NonZeroUsize::MIN),
+        )
+    });
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct VideoGeometry {
+    frames: u32,
+    width: u32,
+    height: u32,
+}
+
+/// Sibling ISO-BMFF boxes of `data` as `(type, body)`. Stops at the first malformed box.
+struct BmffBoxes<'a> {
+    rest: &'a [u8],
+}
+
+impl<'a> Iterator for BmffBoxes<'a> {
+    type Item = ([u8; 4], &'a [u8]);
+
+    fn next(&mut self) -> Option<Self::Item> {
+        let rest = self.rest;
+        let size = u64::from(u32::from_be_bytes(rest.get(0..4)?.try_into().ok()?));
+        let kind: [u8; 4] = rest.get(4..8)?.try_into().ok()?;
+        let (header, size) = match size {
+            0 => (8, rest.len() as u64),
+            1 => (16, u64::from_be_bytes(rest.get(8..16)?.try_into().ok()?)),
+            size => (8, size),
+        };
+        if size < header || size > rest.len() as u64 {
+            self.rest = &[];
+            return None;
+        }
+        let (header, size) = (header as usize, size as usize);
+        self.rest = &rest[size..];
+        Some((kind, &rest[header..size]))
+    }
+}
+
+fn bmff_child<'a>(data: &'a [u8], kind: &[u8; 4]) -> Option<&'a [u8]> {
+    BmffBoxes { rest: data }
+        .find(|(box_kind, _)| box_kind == kind)
+        .map(|(_, body)| body)
+}
+
+/// Sample count and display size of the first video track of an mp4/mov file.
+fn iso_bmff_video_geometry(data: &[u8]) -> Option<VideoGeometry> {
+    let moov = bmff_child(data, b"moov")?;
+    BmffBoxes { rest: moov }
+        .filter(|(kind, _)| kind == b"trak")
+        .find_map(|(_, trak)| {
+            let mdia = bmff_child(trak, b"mdia")?;
+            // hdlr: version/flags, pre_defined, handler_type.
+            if bmff_child(mdia, b"hdlr")?.get(8..12)? != b"vide" {
+                return None;
+            }
+            let stbl = bmff_child(bmff_child(mdia, b"minf")?, b"stbl")?;
+            // stsz: version/flags, sample_size, sample_count.
+            let stsz = bmff_child(stbl, b"stsz")?;
+            let frames = u32::from_be_bytes(stsz.get(8..12)?.try_into().ok()?);
+            // tkhd ends with width and height as 16.16 fixed point in both versions.
+            let tkhd = bmff_child(trak, b"tkhd")?;
+            let end = tkhd.len();
+            let width_at = end.checked_sub(8)?;
+            let width = u32::from_be_bytes(tkhd.get(width_at..end - 4)?.try_into().ok()?) >> 16;
+            let height = u32::from_be_bytes(tkhd.get(end - 4..end)?.try_into().ok()?) >> 16;
+            (frames > 0 && width > 0 && height > 0).then_some(VideoGeometry {
+                frames,
+                width,
+                height,
+            })
+        })
+}
+
+/// Estimated model tokens for one `video_url` part, or `None` when the payload is not a
+/// base64 mp4/mov data URL whose header can be read.
+fn estimate_video_tokens(video_url: &VideoUrl) -> Option<i64> {
+    let payload = parse_base64_video_data_url(&video_url.url)?;
+    let key = sha1_digest(video_url.url.as_bytes());
+    let geometry = VIDEO_ESTIMATE_CACHE.get_or_insert_with(key, || {
+        let bytes = BASE64_STANDARD.decode(payload).ok()?;
+        iso_bmff_video_geometry(&bytes)
+    })?;
+    let groups = i64::from(geometry.frames).saturating_add(VIDEO_FRAMES_PER_TEMPORAL_GROUP - 1)
+        / VIDEO_FRAMES_PER_TEMPORAL_GROUP;
+    let side = |pixels: u32| {
+        i64::from(pixels).saturating_add(VIDEO_PIXELS_PER_TOKEN_SIDE - 1)
+            / VIDEO_PIXELS_PER_TOKEN_SIDE
+    };
+    let per_group = side(geometry.width).saturating_mul(side(geometry.height));
+    Some(
+        groups
+            .max(1)
+            .saturating_mul(per_group.saturating_add(VIDEO_TEMPORAL_GROUP_OVERHEAD_TOKENS)),
+    )
+}
+
+/// Scans one response item for inline base64 video data URLs whose size can be estimated
+/// and returns (payload bytes to subtract, replacement bytes). A video whose header cannot
+/// be read keeps its raw size and logs a warning: over-estimating only compacts early,
+/// under-estimating could send a request past the server's context.
+fn video_data_url_estimate_adjustment(item: &ResponseItem) -> (i64, i64) {
+    let mut payload_bytes = 0i64;
+    let mut replacement_bytes = 0i64;
+    let (ResponseItem::FunctionCallOutput { output, .. }
+    | ResponseItem::CustomToolCallOutput { output, .. }) = item
+    else {
+        return (0, 0);
+    };
+    let FunctionCallOutputBody::ContentItems(items) = &output.body else {
+        return (0, 0);
+    };
+    for content_item in items {
+        let FunctionCallOutputContentItem::InputVideo { video_url } = content_item else {
+            continue;
+        };
+        let Some(payload) = parse_base64_video_data_url(&video_url.url) else {
+            continue;
+        };
+        let Some(tokens) = estimate_video_tokens(video_url) else {
+            tracing::warn!(
+                "video data URL ({} bytes) has no readable mp4/mov header; counting it at its raw size",
+                video_url.url.len()
+            );
+            continue;
+        };
+        payload_bytes =
+            payload_bytes.saturating_add(i64::try_from(payload.len()).unwrap_or(i64::MAX));
+        let tokens = usize::try_from(tokens).unwrap_or(usize::MAX);
+        replacement_bytes = replacement_bytes
+            .saturating_add(i64::try_from(approx_bytes_for_tokens(tokens)).unwrap_or(i64::MAX));
+    }
+    (payload_bytes, replacement_bytes)
+}
+
 fn encrypted_function_output_estimate_adjustment(item: &ResponseItem) -> (i64, i64) {
     let mut payload_bytes = 0i64;
     let mut replacement_bytes = 0i64;
