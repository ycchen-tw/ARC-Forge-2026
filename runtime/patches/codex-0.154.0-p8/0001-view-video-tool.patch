+use codex_protocol::models::VIEW_VIDEO_TOOL_NAME;
+use codex_tools::JsonSchema;
+use codex_tools::ResponsesApiTool;
+use codex_tools::ToolSpec;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ViewVideoToolOptions {
+    pub include_environment_id: bool,
+}
+
+pub fn create_view_video_tool(options: ViewVideoToolOptions) -> ToolSpec {
+    let mut properties = BTreeMap::from([
+        (
+            "path".to_string(),
+            JsonSchema::string(Some("Local filesystem path to a video file.".to_string())),
+        ),
+        (
+            "max_frames".to_string(),
+            JsonSchema::integer(Some(
+                "Maximum number of frames to decode. Without it the server samples frames at its \
+                 own default rate, which silently discards frames."
+                    .to_string(),
+            )),
+        ),
+        (
+            "max_tokens_per_frame".to_string(),
+            JsonSchema::integer(Some(
+                "Vision-token budget per frame. This is what sets the spatial resolution the \
+                 model sees; lower values cost less but blur fine detail."
+                    .to_string(),
+            )),
+        ),
+    ]);
+    if options.include_environment_id {
+        properties.insert(
+            "environment_id".to_string(),
+            JsonSchema::string(Some(
+                "Environment id from <environment_context>. Omit to use the primary environment."
+                    .to_string(),
+            )),
+        );
+    }
+
+    ToolSpec::Function(ResponsesApiTool {
+        name: VIEW_VIDEO_TOOL_NAME.to_string(),
+        description: "View a local video file from the filesystem when motion or change over time \
+                      needs to be inspected. Use this for videos already available on disk; for a \
+                      single still frame use view_image instead."
+            .to_string(),
+        strict: false,
+        defer_loading: None,
+        parameters: JsonSchema::object(properties, Some(vec!["path".to_string()]), Some(false.into())),
+        output_schema: Some(view_video_output_schema()),
+    })
+}
+
+fn view_video_output_schema() -> Value {
+    json!({
+        "type": "object",
+        "properties": {
+            "video_url": {
+                "type": "string",
+                "description": "Data URL for the loaded video."
+            }
+        },
+        "required": ["video_url"],
+        "additionalProperties": false
+    })
+}
