+#[test]
+fn strip_analysis_block_without_block_only_trims() {
+    assert_eq!(strip_analysis_block("  ## State\nlevel 2  \n"), "## State\nlevel 2");
+    assert_eq!(strip_analysis_block("no tags </analysis> here"), "no tags </analysis> here");
+}
+
+#[test]
+fn strip_analysis_block_removes_leading_block() {
+    assert_eq!(
+        strip_analysis_block("<analysis>\ndraft\n</analysis>\n## Game state\nlevel 2"),
+        "## Game state\nlevel 2"
+    );
+}
+
+#[test]
+fn strip_analysis_block_removes_every_block_and_keeps_text_between() {
+    assert_eq!(
+        strip_analysis_block("a<analysis>x</analysis>b\n<analysis>y\n</analysis>c"),
+        "ab\nc"
+    );
+}
+
+#[test]
+fn strip_analysis_block_drops_unclosed_block_to_end() {
+    assert_eq!(
+        strip_analysis_block("## Summary\nkeep\n<analysis>unfinished draft"),
+        "## Summary\nkeep"
+    );
+    assert_eq!(
+        strip_analysis_block("<analysis>a</analysis>kept<analysis>b"),
+        "kept"
+    );
+}
+
+#[test]
+fn strip_analysis_block_analysis_only_is_empty() {
+    assert_eq!(strip_analysis_block("<analysis>only a draft</analysis>\n"), "");
+    assert_eq!(strip_analysis_block("  <analysis>never closed"), "");
+}
+
+#[test]
+fn strip_analysis_from_assistant_message_rewrites_in_place() {
+    let message = |role: &str, text: &str| ResponseItem::Message {
+        id: None,
+        role: role.to_string(),
+        content: vec![ContentItem::OutputText {
+            text: text.to_string(),
+        }],
+        phase: None,
+        internal_chat_message_metadata_passthrough: None,
+    };
+    let mut item = message("assistant", "<analysis>draft</analysis>\n## State\nx");
+    assert!(!strip_analysis_from_assistant_message(&mut item));
+    assert_eq!(item, message("assistant", "## State\nx"));
+
+    let mut only_draft = message("assistant", "<analysis>draft</analysis>");
+    assert!(strip_analysis_from_assistant_message(&mut only_draft));
+    assert_eq!(only_draft, message("assistant", ""));
+
+    let mut user = message("user", "<analysis>kept</analysis>");
+    assert!(!strip_analysis_from_assistant_message(&mut user));
+    assert_eq!(user, message("user", "<analysis>kept</analysis>"));
+}
