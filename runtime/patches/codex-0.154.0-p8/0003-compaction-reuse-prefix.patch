+/// Applies [`strip_analysis_block`] to each output text of an assistant message, in place.
+/// Returns true when the message had text and nothing is left of it.
+fn strip_analysis_from_assistant_message(item: &mut ResponseItem) -> bool {
+    let ResponseItem::Message { role, content, .. } = item else {
+        return false;
+    };
+    if role != "assistant" {
+        return false;
+    }
+    let mut had_text = false;
+    let mut left_text = false;
+    for part in content.iter_mut() {
+        if let ContentItem::OutputText { text } = part {
+            had_text |= !text.trim().is_empty();
+            *text = strip_analysis_block(text);
+            left_text |= !text.is_empty();
+        }
+    }
+    had_text && !left_text
+}
+
+/// Removes every `<analysis>...</analysis>` block (a scratchpad a compaction prompt may ask for
+/// ahead of the summary) and, if an `<analysis>` is left unclosed, everything from it to the end.
+/// Text outside the blocks is kept; only leading and trailing whitespace is trimmed.
+pub(crate) fn strip_analysis_block(text: &str) -> String {
+    const OPEN: &str = "<analysis>";
+    const CLOSE: &str = "</analysis>";
+    let mut kept = String::with_capacity(text.len());
+    let mut rest = text;
+    while let Some(start) = rest.find(OPEN) {
+        kept.push_str(&rest[..start]);
+        let after_open = &rest[start + OPEN.len()..];
+        match after_open.find(CLOSE) {
+            Some(end) => rest = &after_open[end + CLOSE.len()..],
+            None => {
+                rest = "";
+                break;
+            }
+        }
+    }
+    kept.push_str(rest);
+    kept.trim().to_string()
+}
