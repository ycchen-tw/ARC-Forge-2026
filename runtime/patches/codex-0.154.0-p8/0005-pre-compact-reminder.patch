+/// Context size when the pre-compaction reminder was last sent; 0 = armed. A compaction shrinks
+/// the context below it, which re-arms the reminder for the new window.
+static PRE_COMPACT_REMINDED_AT: std::sync::atomic::AtomicI64 = std::sync::atomic::AtomicI64::new(0);
+
+/// `features.pre_compact_reminder`: once per context window, when the context passes the
+/// threshold on the first line of `$CODEX_HOME/compact_reminder`, add the rest of that file as a
+/// user message so the model can write down what it knows before the auto-compaction summarises.
+async fn maybe_remind_before_compaction(
+    sess: &Arc<Session>,
+    codex_home: &codex_utils_absolute_path::AbsolutePathBuf,
+    active_context_tokens: i64,
+) {
+    use std::sync::atomic::Ordering;
+    let last = PRE_COMPACT_REMINDED_AT.load(Ordering::Relaxed);
+    if last > 0 && active_context_tokens < last {
+        PRE_COMPACT_REMINDED_AT.store(0, Ordering::Relaxed);
+    } else if last > 0 {
+        return;
+    }
+    let path = codex_home.join("compact_reminder");
+    let text = match std::fs::read_to_string(&path) {
+        Ok(text) => text,
+        Err(err) => {
+            error!("pre-compaction reminder {}: {err}", path.display());
+            return;
+        }
+    };
+    let (first, message) = text.split_once('\n').unwrap_or((text.as_str(), ""));
+    let threshold = match first.trim().parse::<i64>() {
+        Ok(threshold) => threshold,
+        Err(err) => {
+            error!("pre-compaction reminder {}: first line {first:?} is not a token count ({err})", path.display());
+            return;
+        }
+    };
+    let message = message.trim();
+    if active_context_tokens < threshold || message.is_empty() {
+        return;
+    }
+    PRE_COMPACT_REMINDED_AT.store(active_context_tokens, Ordering::Relaxed);
+    info!(active_context_tokens, threshold, "pre-compaction reminder");
+    let item = ResponseItem::Message {
+        id: None,
+        role: "user".to_string(),
+        content: vec![ContentItem::InputText {
+            text: message.to_string(),
+        }],
+        phase: None,
+        internal_chat_message_metadata_passthrough: None,
+    };
+    if sess.inject_if_running(vec![item]).await.is_err() {
+        error!("pre-compaction reminder: no running turn to inject into");
+        PRE_COMPACT_REMINDED_AT.store(0, Ordering::Relaxed);
+    }
+}
