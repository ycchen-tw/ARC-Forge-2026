+/// The pre-compaction reminder has done its job once the compaction it announced has happened:
+/// a compaction must not carry it into the next window (patch 0006). Without this, each window's
+/// reminder was kept among the recent user messages and they piled up ahead of the summary,
+/// still saying a compaction was about to happen. The text is the same file
+/// `maybe_remind_before_compaction` reads, found through `CODEX_HOME` (the harness always sets it;
+/// no file means the feature is off and nothing is dropped). Read once per process.
+pub(crate) fn is_pre_compact_reminder(message: &str) -> bool {
+    static REMINDER: std::sync::OnceLock<Option<String>> = std::sync::OnceLock::new();
+    let reminder = REMINDER.get_or_init(|| {
+        let home = std::env::var_os("CODEX_HOME")?;
+        let text = std::fs::read_to_string(std::path::Path::new(&home).join("compact_reminder")).ok()?;
+        let (_, message) = text.split_once('\n')?;
+        let message = message.trim();
+        (!message.is_empty()).then(|| message.to_string())
+    });
+    reminder.as_deref().is_some_and(|reminder| message.trim() == reminder)
+}
