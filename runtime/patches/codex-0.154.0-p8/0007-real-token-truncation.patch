+++ b/codex-rs/utils/output-truncation/src/real_tokens.rs
@@ -0,0 +1,137 @@
+//! Patch 0007: count tool-output token budgets with the served model's own tokenizer.
+//!
+//! Without it a `Tokens(n)` budget is `n * 4` bytes, and an unknown model slug gets a byte
+//! policy anyway (`tool_output_token_limit` turns into `limit * 4` bytes). Grid dumps run at
+//! about one token per byte, so "2,500 tokens" let ~10,000 real tokens through. With
+//! `tool_output_tokenizer = "/path/tokenizer.json"` every `Tokens` budget in this crate is real
+//! tokens: keep the first half and the last half of the budget, cut the middle on a char
+//! boundary, and report the real number of tokens removed.
+
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::OnceLock;
+
+use codex_protocol::protocol::TruncationPolicy;
+use tokenizers::Tokenizer;
+
+static TOKENIZER: OnceLock<(PathBuf, Tokenizer)> = OnceLock::new();
+
+/// Load the tokenizer once per process. Loading the same path again is a no-op; a different
+/// path is an error, since budgets already applied would silently change meaning.
+pub fn install_tool_output_tokenizer(path: &Path) -> Result<(), String> {
+    if TOKENIZER.get().is_none() {
+        let mut tokenizer = Tokenizer::from_file(path).map_err(|err| {
+            format!(
+                "failed to load tool_output_tokenizer {}: {err}",
+                path.display()
+            )
+        })?;
+        // A tokenizer.json may carry padding/truncation for batching; neither belongs in a count.
+        tokenizer.with_padding(None);
+        tokenizer
+            .with_truncation(None)
+            .map_err(|err| format!("tool_output_tokenizer {}: {err}", path.display()))?;
+        // Losing a race to another thread is fine as long as it installed the same file.
+        let _ = TOKENIZER.set((path.to_path_buf(), tokenizer));
+    }
+    let (installed, _) = TOKENIZER
+        .get()
+        .expect("tool_output_tokenizer was just installed");
+    if installed != path {
+        return Err(format!(
+            "tool_output_tokenizer is already {}, refusing {}",
+            installed.display(),
+            path.display()
+        ));
+    }
+    Ok(())
+}
+
+pub fn tool_output_tokenizer_installed() -> bool {
+    TOKENIZER.get().is_some()
+}
+
+/// The real token count of `text`, or `None` when no tokenizer is installed.
+pub fn tool_output_token_count(text: &str) -> Option<usize> {
+    TOKENIZER.get().map(|(_, tokenizer)| count(tokenizer, text))
+}
+
+pub(crate) fn real_tokenizer(policy: TruncationPolicy) -> Option<&'static Tokenizer> {
+    match policy {
+        TruncationPolicy::Tokens(_) => TOKENIZER.get().map(|(_, tokenizer)| tokenizer),
+        TruncationPolicy::Bytes(_) => None,
+    }
+}
+
+pub(crate) fn count(tokenizer: &Tokenizer, text: &str) -> usize {
+    tokenizer
+        .encode_fast(text, /*add_special_tokens*/ false)
+        .unwrap_or_else(|err| panic!("tool_output_tokenizer failed to encode: {err}"))
+        .len()
+}
+
+/// Keep at most `max_tokens / 2` tokens from the start and the rest of the budget from the end,
+/// both re-counted on the kept text, with the original marker format.
+pub(crate) fn truncate_middle_real_tokens(
+    s: &str,
+    max_tokens: usize,
+    tokenizer: &Tokenizer,
+) -> String {
+    let offsets = tokenizer
+        .encode(s, /*add_special_tokens*/ false)
+        .unwrap_or_else(|err| panic!("tool_output_tokenizer failed to encode: {err}"))
+        .get_offsets()
+        .to_vec();
+    let total = offsets.len();
+    if total <= max_tokens {
+        return s.to_string();
+    }
+    let left = max_tokens / 2;
+    let right = max_tokens - left;
+
+    // A token can be half of a multi-byte char, so a cut at its offset is snapped to a char
+    // boundary and the kept side re-counted; step one token inward until it fits.
+    let mut keep = left;
+    let prefix_end = loop {
+        if keep == 0 {
+            break 0;
+        }
+        let end = floor_char_boundary(s, offsets[keep].0);
+        if count(tokenizer, &s[..end]) <= left {
+            break end;
+        }
+        keep -= 1;
+    };
+    let mut keep = right;
+    let suffix_start = loop {
+        if keep == 0 {
+            break s.len();
+        }
+        let start = ceil_char_boundary(s, offsets[total - keep].0).max(prefix_end);
+        if count(tokenizer, &s[start..]) <= right {
+            break start;
+        }
+        keep -= 1;
+    };
+
+    let prefix = &s[..prefix_end];
+    let suffix = &s[suffix_start..];
+    let removed = total.saturating_sub(count(tokenizer, prefix) + count(tokenizer, suffix));
+    format!("{prefix}…{removed} tokens truncated…{suffix}")
+}
+
+fn floor_char_boundary(s: &str, mut index: usize) -> usize {
+    index = index.min(s.len());
+    while !s.is_char_boundary(index) {
+        index -= 1;
+    }
+    index
+}
+
+fn ceil_char_boundary(s: &str, mut index: usize) -> usize {
+    index = index.min(s.len());
+    while !s.is_char_boundary(index) {
+        index += 1;
+    }
+    index
+}
diff --git a/codex-rs/utils/output-truncation/tests/real_tokens.rs b/codex-rs/utils/output-truncation/tests/real_tokens.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/utils/output-truncation/tests/real_tokens.rs
@@ -0,0 +1,197 @@
+//! Patch 0007 with a tokenizer installed. A separate test binary, because the tokenizer is
+//! process-global: the unit tests in `src/` run without one and pin the original behavior.
+
+use std::path::PathBuf;
+use std::sync::Once;
+
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_utils_output_truncation::TruncationPolicy;
+use codex_utils_output_truncation::fits_policy;
+use codex_utils_output_truncation::formatted_truncate_text;
+use codex_utils_output_truncation::install_tool_output_tokenizer;
+use codex_utils_output_truncation::tool_output_token_count;
+use codex_utils_output_truncation::truncate_function_output_items_with_policy;
+use codex_utils_output_truncation::truncate_text;
+use tokenizers::Tokenizer;
+use tokenizers::models::bpe::BPE;
+use tokenizers::pre_tokenizers::byte_level::ByteLevel;
+
+/// Byte-level BPE with a handful of merges: ASCII words get multi-byte tokens, while CJK and
+/// emoji stay one token per byte, so cuts regularly land inside a char.
+fn install() {
+    static WRITE: Once = Once::new();
+    let path =
+        std::env::temp_dir().join(format!("codex-0007-tokenizer-{}.json", std::process::id()));
+    WRITE.call_once(|| {
+        let merges = [
+            ("Ġ", "t"),
+            ("h", "e"),
+            ("Ġt", "he"),
+            ("0", "0"),
+            ("1", "2"),
+            ("a", "b"),
+        ];
+        let mut alphabet: Vec<String> = ByteLevel::alphabet()
+            .into_iter()
+            .map(|ch| ch.to_string())
+            .collect();
+        alphabet.sort_unstable();
+        alphabet.extend(merges.iter().map(|(a, b)| format!("{a}{b}")));
+        let vocab: Vec<String> = alphabet
+            .iter()
+            .enumerate()
+            .map(|(id, token)| format!("{:?}:{id}", token))
+            .collect();
+        let vocab_path = path.with_extension("vocab.json");
+        let merges_path = path.with_extension("merges.txt");
+        std::fs::write(&vocab_path, format!("{{{}}}", vocab.join(","))).expect("write vocab");
+        let merges: Vec<String> = merges.iter().map(|(a, b)| format!("{a} {b}")).collect();
+        std::fs::write(&merges_path, merges.join("\n")).expect("write merges");
+        let bpe = BPE::from_file(vocab_path.to_str().unwrap(), merges_path.to_str().unwrap())
+            .build()
+            .expect("bpe");
+        let mut tokenizer = Tokenizer::new(bpe);
+        tokenizer.with_pre_tokenizer(Some(ByteLevel::default().add_prefix_space(false)));
+        tokenizer
+            .save(&path, /*pretty*/ false)
+            .expect("save tokenizer");
+    });
+    install_tool_output_tokenizer(&path).expect("install");
+}
+
+fn count(text: &str) -> usize {
+    tool_output_token_count(text).expect("installed")
+}
+
+fn mixed_text() -> String {
+    let grid: String = (0..64)
+        .map(|row| {
+            (0..64)
+                .map(|col| format!("{:x}", (row * 7 + col) % 16))
+                .collect::<String>()
+                + "\n"
+        })
+        .collect();
+    format!("the start 中文字串 🎉🎉 {grid} the middle ab12 00 終わり 👩‍👩‍👧 the end")
+}
+
+/// `(prefix, removed, suffix)` of a truncated output.
+fn split_marker(out: &str) -> (&str, usize, &str) {
+    let start = out.find('…').expect("marker start");
+    let rest = &out[start + '…'.len_utf8()..];
+    let end = rest.find(" tokens truncated…").expect("marker end");
+    let removed = rest[..end].parse().expect("removed count");
+    (
+        &out[..start],
+        removed,
+        &rest[end + " tokens truncated…".len()..],
+    )
+}
+
+#[test]
+fn keeps_half_budget_each_side_and_reports_real_removed_count() {
+    install();
+    let text = mixed_text();
+    let total = count(&text);
+    for limit in [1, 2, 3, 7, 10, 101, 1000, total - 1] {
+        let out = truncate_text(&text, TruncationPolicy::Tokens(limit));
+        let (prefix, removed, suffix) = split_marker(&out);
+        let (left, right) = (count(prefix), count(suffix));
+        assert!(left <= limit / 2, "limit {limit}: prefix has {left} tokens");
+        assert!(
+            right <= limit - limit / 2,
+            "limit {limit}: suffix has {right} tokens"
+        );
+        assert!(left + right <= limit);
+        // Only snapping a split char may cost a token or two per side.
+        assert!(
+            left + 4 >= limit / 2 && right + 4 >= limit - limit / 2,
+            "limit {limit}: {left}+{right}"
+        );
+        assert!(text.starts_with(prefix) && text.ends_with(suffix));
+        assert_eq!(removed, total - left - right);
+    }
+}
+
+#[test]
+fn cuts_inside_multibyte_chars_without_panicking() {
+    install();
+    // No merges apply: every byte of every char is its own token.
+    let text = "中文🎉👩‍👩‍👧".repeat(50);
+    let total = count(&text);
+    assert_eq!(total, text.len());
+    for limit in 0..40 {
+        let out = truncate_text(&text, TruncationPolicy::Tokens(limit));
+        let (prefix, removed, suffix) = split_marker(&out);
+        assert!(count(prefix) <= limit / 2 && count(suffix) <= limit - limit / 2);
+        assert_eq!(removed, total - count(prefix) - count(suffix));
+    }
+}
+
+#[test]
+fn under_budget_is_untouched_and_bytes_policy_is_unchanged() {
+    install();
+    let text = mixed_text();
+    let total = count(&text);
+    assert_eq!(truncate_text(&text, TruncationPolicy::Tokens(total)), text);
+    assert_eq!(
+        formatted_truncate_text(&text, TruncationPolicy::Tokens(total)),
+        text
+    );
+    assert_eq!(truncate_text("", TruncationPolicy::Tokens(0)), "");
+    assert!(fits_policy(&text, TruncationPolicy::Tokens(total)));
+    assert!(!fits_policy(&text, TruncationPolicy::Tokens(total - 1)));
+    // The grid is about one token per byte: the old `bytes / 4` estimate would have passed it.
+    assert!(text.len() <= TruncationPolicy::Tokens(total / 2).byte_budget());
+    assert!(!fits_policy(&text, TruncationPolicy::Tokens(total / 2)));
+    // A byte budget never consults the tokenizer.
+    assert!(fits_policy(&text, TruncationPolicy::Bytes(text.len())));
+}
+
+#[test]
+fn formatted_output_reports_the_real_original_count() {
+    install();
+    let text = mixed_text();
+    let out = formatted_truncate_text(&text, TruncationPolicy::Tokens(100));
+    let header = format!(
+        "Warning: truncated output (original token count: {})\nTotal output lines: {}\n\n",
+        count(&text),
+        text.lines().count()
+    );
+    assert!(out.starts_with(&header), "{out}");
+    let (prefix, _, suffix) = split_marker(&out[header.len()..]);
+    assert!(count(prefix) + count(suffix) <= 100);
+}
+
+#[test]
+fn content_items_are_charged_real_tokens() {
+    install();
+    let text = mixed_text();
+    let items = vec![
+        FunctionCallOutputContentItem::InputText {
+            text: "the the".to_string(),
+        },
+        FunctionCallOutputContentItem::InputText { text: text.clone() },
+    ];
+    let out =
+        truncate_function_output_items_with_policy(&items, TruncationPolicy::Tokens(50), |_| 0);
+    let [
+        FunctionCallOutputContentItem::InputText { text: first },
+        FunctionCallOutputContentItem::InputText { text: second },
+    ] = out.as_slice()
+    else {
+        panic!("{out:?}");
+    };
+    assert_eq!(first, "the the");
+    let (prefix, _, suffix) = split_marker(second);
+    assert!(count(prefix) + count(suffix) <= 50 - count("the the"));
+}
+
+#[test]
+fn install_is_once_per_process() {
+    install();
+    install();
+    let err = install_tool_output_tokenizer(&PathBuf::from("/nonexistent/tokenizer.json"))
+        .expect_err("a second, different tokenizer must be refused");
+    assert!(err.contains("already"), "{err}");
+}
