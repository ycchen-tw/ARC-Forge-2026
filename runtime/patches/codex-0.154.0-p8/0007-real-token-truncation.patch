@@ -0,0 +1,19 @@
+//! Patch 0007: a tokenizer that cannot be loaded is an error, never a silent byte estimate.
+
+use std::path::Path;
+
+use codex_utils_output_truncation::install_tool_output_tokenizer;
+use codex_utils_output_truncation::tool_output_tokenizer_installed;
+
+#[test]
+fn unreadable_or_invalid_tokenizer_is_an_error() {
+    let missing = install_tool_output_tokenizer(Path::new("/nonexistent/tokenizer.json"))
+        .expect_err("missing file");
+    assert!(missing.contains("/nonexistent/tokenizer.json"), "{missing}");
+
+    let garbage =
+        std::env::temp_dir().join(format!("codex-0007-garbage-{}.json", std::process::id()));
+    std::fs::write(&garbage, "{\"not\": \"a tokenizer\"}").expect("write");
+    install_tool_output_tokenizer(&garbage).expect_err("invalid tokenizer.json");
+    assert!(!tool_output_tokenizer_installed());
+}
