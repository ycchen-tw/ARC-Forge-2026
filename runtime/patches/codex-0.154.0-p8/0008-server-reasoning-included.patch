diff --git a/codex-rs/core/src/context_manager/history_tests.rs b/codex-rs/core/src/context_manager/history_tests.rs
index 517e2fa..aadb4c1 100644
--- a/codex-rs/core/src/context_manager/history_tests.rs
+++ b/codex-rs/core/src/context_manager/history_tests.rs
@@ -3011,3 +3011,30 @@ fn unreadable_video_keeps_its_raw_size() {
     let raw_len = serde_json::to_string(&item).unwrap().len() as i64;
     assert_eq!(estimate_response_item_model_visible_bytes(&item), raw_len);
 }
+
+#[test]
+fn reasoning_before_a_mid_turn_user_message_is_added_only_when_the_server_does_not_count_it() {
+    // What patch 0008 switches: a mid-turn user message (0005's pre-compaction reminder) makes
+    // every earlier reasoning item "non-last"; with server_reasoning_included=false its estimate
+    // is added on top of the server usage, with true (features.server_reasoning_included) not.
+    let reasoning = reasoning_with_encrypted_content(/*len*/ 40_000);
+    let mut history = create_history_with_items(vec![
+        user_msg("play"),
+        reasoning.clone(),
+        assistant_msg("ok"),
+        user_msg("context nearly full"),
+    ]);
+    history.update_token_info(
+        &TokenUsage {
+            total_tokens: 1_000,
+            ..Default::default()
+        },
+        /*model_context_window*/ None,
+    );
+    let included = history.get_total_token_usage(/*server_reasoning_included*/ true);
+    assert_eq!(
+        history.get_total_token_usage(/*server_reasoning_included*/ false),
+        included + estimate_item_token_count(&reasoning)
+    );
+    assert!(estimate_item_token_count(&reasoning) > 7_000);
+}
