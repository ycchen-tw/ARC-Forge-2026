         let state = self.state.lock().await;
-        state.get_total_token_usage(state.server_reasoning_included())
+        // Patch 0008: `features.server_reasoning_included` declares that the provider's usage
+        // already counts the earlier reasoning it is sent back (sglang does: the request after a
+        // mid-turn user message grows by that message only). This is the only reader of the
+        // per-stream flag, so overriding here covers every writer: the reset to false at each
+        // turn start (tasks/regular.rs), the response header and the compaction stream.
+        let server_reasoning_included = state.server_reasoning_included()
+            || self.features.enabled(Feature::ServerReasoningIncluded);
+        state.get_total_token_usage(server_reasoning_included)
     }
 
