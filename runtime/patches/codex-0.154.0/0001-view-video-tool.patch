@@ -0,0 +1,258 @@
+use codex_exec_server::GetMetadataOptions;
+use codex_exec_server::ReadFileOptions;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::FunctionCallOutputPayload;
+use codex_protocol::models::ResponseInputItem;
+use codex_protocol::models::VideoUrl;
+use codex_protocol::openai_models::InputModality;
+use codex_utils_image::data_url_from_bytes;
+use serde::Deserialize;
+use std::path::Path;
+
+use crate::function_tool::FunctionCallError;
+use crate::tools::context::ToolInvocation;
+use crate::tools::context::ToolOutput;
+use crate::tools::context::ToolPayload;
+use crate::tools::context::boxed_tool_output;
+use crate::tools::handlers::parse_arguments;
+use crate::tools::handlers::resolve_tool_environment;
+use crate::tools::handlers::view_video_spec::ViewVideoToolOptions;
+use crate::tools::handlers::view_video_spec::create_view_video_tool;
+use crate::tools::registry::CoreToolRuntime;
+use crate::tools::registry::ToolExecutor;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+
+pub struct ViewVideoHandler {
+    options: ViewVideoToolOptions,
+}
+
+impl Default for ViewVideoHandler {
+    fn default() -> Self {
+        Self {
+            options: ViewVideoToolOptions {
+                include_environment_id: false,
+            },
+        }
+    }
+}
+
+impl ViewVideoHandler {
+    pub(crate) fn new(options: ViewVideoToolOptions) -> Self {
+        Self { options }
+    }
+}
+
+const VIEW_VIDEO_UNSUPPORTED_MESSAGE: &str =
+    "view_video is not allowed because you do not support video inputs";
+
+/// Data URLs inline the whole file into the request body, so an unbounded read
+/// turns a stray large file into a multi-gigabyte request. Refuse early and say
+/// why, rather than letting the server reject an opaque oversized payload.
+const MAX_PROMPT_VIDEO_INPUT_BYTES: u64 = 100 * 1024 * 1024;
+
+/// Extension-based, because the decoder lives on the server and we have no
+/// container parser here. An unknown extension is rejected rather than guessed:
+/// a mislabeled data URL fails deep inside the server with an error that does
+/// not point back at this tool.
+fn video_mime_for_path(path: &Path) -> Option<&'static str> {
+    let extension = path.extension()?.to_str()?;
+    if extension.eq_ignore_ascii_case("mp4") {
+        Some("video/mp4")
+    } else if extension.eq_ignore_ascii_case("webm") {
+        Some("video/webm")
+    } else if extension.eq_ignore_ascii_case("mkv") {
+        Some("video/x-matroska")
+    } else if extension.eq_ignore_ascii_case("mov") {
+        Some("video/quicktime")
+    } else if extension.eq_ignore_ascii_case("avi") {
+        Some("video/x-msvideo")
+    } else {
+        None
+    }
+}
+
+#[derive(Deserialize)]
+struct ViewVideoArgs {
+    path: String,
+    #[serde(default)]
+    environment_id: Option<String>,
+    #[serde(default)]
+    max_frames: Option<u32>,
+    #[serde(default)]
+    max_tokens_per_frame: Option<u32>,
+}
+
+impl ToolExecutor<ToolInvocation> for ViewVideoHandler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("view_video")
+    }
+
+    fn spec(&self) -> ToolSpec {
+        create_view_video_tool(self.options)
+    }
+
+    fn supports_parallel_tool_calls(&self) -> bool {
+        true
+    }
+
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(self.handle_call(invocation))
+    }
+}
+
+impl ViewVideoHandler {
+    async fn handle_call(
+        &self,
+        invocation: ToolInvocation,
+    ) -> Result<Box<dyn ToolOutput>, FunctionCallError> {
+        if !invocation
+            .turn
+            .model_info()
+            .input_modalities
+            .contains(&InputModality::Video)
+        {
+            return Err(FunctionCallError::RespondToModel(
+                VIEW_VIDEO_UNSUPPORTED_MESSAGE.to_string(),
+            ));
+        }
+
+        let ToolInvocation {
+            turn: _turn,
+            step_context,
+            payload,
+            ..
+        } = invocation;
+
+        let arguments = match payload {
+            ToolPayload::Function { arguments } => arguments,
+            _ => {
+                return Err(FunctionCallError::RespondToModel(
+                    "view_video handler received unsupported payload".to_string(),
+                ));
+            }
+        };
+
+        let ViewVideoArgs {
+            path,
+            environment_id,
+            max_frames,
+            max_tokens_per_frame,
+        } = parse_arguments(&arguments)?;
+
+        let Some(turn_environment) =
+            resolve_tool_environment(&step_context.environments, environment_id.as_deref())?
+        else {
+            return Err(FunctionCallError::RespondToModel(
+                "view_video is unavailable in this session".to_string(),
+            ));
+        };
+        let path_uri = turn_environment.cwd().join(&path).map_err(|err| {
+            FunctionCallError::RespondToModel(format!(
+                "unable to resolve video path `{path}` against environment cwd `{}`: {err}",
+                turn_environment.cwd(),
+            ))
+        })?;
+        let model_visible_path = path_uri.inferred_native_path_string();
+
+        let mime = video_mime_for_path(Path::new(&model_visible_path)).ok_or_else(|| {
+            FunctionCallError::RespondToModel(format!(
+                "unsupported video format for `{model_visible_path}`; expected one of \
+                 .mp4, .webm, .mkv, .mov, .avi"
+            ))
+        })?;
+
+        let sandbox = turn_environment.sandbox_context(/*additional_permissions*/ None);
+        let fs = turn_environment.environment.get_filesystem();
+
+        let metadata = fs
+            .get_metadata(&path_uri, GetMetadataOptions::default(), Some(&sandbox))
+            .await
+            .map_err(|error| {
+                FunctionCallError::RespondToModel(format!(
+                    "unable to locate video at `{model_visible_path}`: {error}"
+                ))
+            })?;
+
+        if !metadata.is_file {
+            return Err(FunctionCallError::RespondToModel(format!(
+                "video path `{model_visible_path}` is not a file"
+            )));
+        }
+        if metadata.size > MAX_PROMPT_VIDEO_INPUT_BYTES {
+            return Err(FunctionCallError::RespondToModel(format!(
+                "video at `{model_visible_path}` is {} bytes, over the {MAX_PROMPT_VIDEO_INPUT_BYTES} byte limit",
+                metadata.size
+            )));
+        }
+
+        let file_bytes = fs
+            .read_file(&path_uri, ReadFileOptions::default(), Some(&sandbox))
+            .await
+            .map_err(|error| {
+                FunctionCallError::RespondToModel(format!(
+                    "unable to read video at `{model_visible_path}`: {error}"
+                ))
+            })?;
+
+        let url = data_url_from_bytes(mime, &file_bytes);
+
+        Ok(boxed_tool_output(ViewVideoOutput {
+            video_url: VideoUrl {
+                url,
+                max_frames,
+                max_tokens_per_frame,
+                fps: None,
+            },
+        }))
+    }
+}
+
+impl CoreToolRuntime for ViewVideoHandler {
+    fn is_builtin_control_tool(&self) -> bool {
+        true
+    }
+}
+
+pub struct ViewVideoOutput {
+    video_url: VideoUrl,
+}
+
+impl ToolOutput for ViewVideoOutput {
+    fn log_output(&self) -> String {
+        format!(
+            "<video data URL omitted: {} bytes, max_frames={:?}, max_tokens_per_frame={:?}>",
+            self.video_url.url.len(),
+            self.video_url.max_frames,
+            self.video_url.max_tokens_per_frame,
+        )
+    }
+
+    fn success_for_logging(&self) -> bool {
+        true
+    }
+
+    fn to_response_item(&self, call_id: &str, _payload: &ToolPayload) -> ResponseInputItem {
+        let body =
+            FunctionCallOutputBody::ContentItems(vec![FunctionCallOutputContentItem::InputVideo {
+                video_url: self.video_url.clone(),
+            }]);
+        let output = FunctionCallOutputPayload {
+            body,
+            success: Some(true),
+        };
+
+        ResponseInputItem::FunctionCallOutput {
+            call_id: call_id.to_string(),
+            output,
+        }
+    }
+
+    fn code_mode_result(&self, _payload: &ToolPayload) -> serde_json::Value {
+        serde_json::json!({ "video_url": self.video_url.url })
+    }
+}
diff --git a/codex-rs/core/src/tools/handlers/view_video_spec.rs b/codex-rs/core/src/tools/handlers/view_video_spec.rs
