+/// Strip video content from tool outputs when the model does not support video.
+/// When `input_modalities` contains `InputModality::Video`, no stripping is performed.
+///
+/// Only tool outputs are walked: video enters history exclusively through the
+/// `view_video` tool, so there is no message-content counterpart to strip.
+pub(crate) fn strip_video_when_unsupported(
+    input_modalities: &[InputModality],
+    items: &mut [ResponseItemEnvelope],
+) {
+    if input_modalities.contains(&InputModality::Video) {
+        return;
+    }
+
+    for envelope in items.iter_mut() {
+        match &mut envelope.item {
+            ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } => {
+                if let Some(content_items) = output.content_items_mut() {
+                    for content_item in content_items.iter_mut() {
+                        if matches!(
+                            content_item,
+                            FunctionCallOutputContentItem::InputVideo { .. }
+                        ) {
+                            *content_item = FunctionCallOutputContentItem::InputText {
+                                text: UnsupportedMedia::VIDEO.render(),
+                            };
+                        }
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+}
