+#[test]
+fn sglang_session_id_follows_window_id_only_when_enabled() -> anyhow::Result<()> {
+    let client = test_model_client(SessionSource::Cli);
+    let window_id = format!("{}:3", client.state.thread_id);
+    let build = |client: &ModelClient| {
+        client.build_responses_request(
+            &Prompt::default(),
+            &test_model_info(),
+            /*effort*/ None,
+            codex_protocol::config_types::ReasoningSummary::None,
+            /*service_tier*/ None,
+            &test_responses_metadata_for_client(
+                client,
+                /*turn_id*/ None,
+                window_id.clone(),
+                /*parent_thread_id*/ None,
+                TestCodexResponsesRequestKind::Turn,
+            ),
+        )
+    };
+
+    let off = serde_json::to_value(build(&client)?)?;
+    assert_eq!(off.get("session_id"), None);
+
+    let client = client
+        .with_sglang_close_session_url(Some("http://127.0.0.1:30000/close_session".to_string()));
+    let on = serde_json::to_value(build(&client)?)?;
+    assert_eq!(on["session_id"], serde_json::json!(window_id));
+    Ok(())
+}
