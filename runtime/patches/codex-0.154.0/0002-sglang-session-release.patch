+/// sglang serves `/close_session` at the server root while the provider base URL points at
+/// its OpenAI-compatible `/v1` prefix.
+pub(crate) fn sglang_close_session_url(
+    base_url: Option<&str>,
+) -> std::result::Result<String, String> {
+    base_url
+        .and_then(|base_url| {
+            let base_url = base_url.strip_suffix('/').unwrap_or(base_url);
+            base_url.strip_suffix("/v1")
+        })
+        .map(|root| format!("{root}/close_session"))
+        .ok_or_else(|| {
+            format!(
+                "feature `sglang_session_release` needs a provider base_url ending in `/v1`, got {base_url:?}"
+            )
+        })
 }
 
