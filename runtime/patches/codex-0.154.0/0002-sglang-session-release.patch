+    assert_eq!(
+        super::sglang_close_session_url(Some("http://127.0.0.1:30044/v1/")),
+        Ok("http://127.0.0.1:30044/close_session".to_string())
+    );
+    assert!(super::sglang_close_session_url(Some("http://127.0.0.1:30044")).is_err());
