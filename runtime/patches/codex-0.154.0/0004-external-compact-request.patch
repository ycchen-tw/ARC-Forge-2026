+/// `features.external_compact_request`: a harness asks for a compaction by creating
+/// `$CODEX_HOME/compact_request`. The file may hold a token count; below it the request is
+/// dropped (an early, small context is not worth summarising). Either way the file is consumed
+/// here, at a point where the turn can roll over into a new window.
+fn take_external_compact_request(
+    codex_home: &codex_utils_absolute_path::AbsolutePathBuf,
+    active_context_tokens: i64,
+) -> bool {
+    let path = codex_home.join("compact_request");
+    let text = match std::fs::read_to_string(&path) {
+        Ok(text) => text,
+        Err(err) if err.kind() == std::io::ErrorKind::NotFound => return false,
+        Err(err) => {
+            error!("external compact request {}: {err}", path.display());
+            return false;
+        }
+    };
+    if let Err(err) = std::fs::remove_file(&path) {
+        error!(
+            "cannot consume external compact request {}: {err}",
+            path.display()
+        );
+        return false;
+    }
+    let min_tokens = match text.trim() {
+        "" => 0,
+        value => match value.parse::<i64>() {
+            Ok(tokens) => tokens,
+            Err(err) => {
+                error!(
+                    "external compact request {}: {value:?} is not a token count ({err}); compacting",
+                    path.display()
+                );
+                0
+            }
+        },
+    };
+    let accepted = active_context_tokens >= min_tokens;
+    info!(active_context_tokens, min_tokens, accepted, "external compact request");
+    accepted
+}
