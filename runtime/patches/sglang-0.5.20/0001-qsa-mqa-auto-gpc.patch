From 08e76b982b4e419abfa30aa3def03c9362c81f24 Mon Sep 17 00:00:00 2001
From: arc <a@b.c>
Date: Sat, 19 Sep 2026 08:13:10 +0000
Subject: [PATCH 1/7] arc: 0006-qsa-mqa-auto-gpc

---
 python/sglang/srt/environ.py                  |  3 +++
 python/sglang/srt/layers/attention/qsa/mqa.py | 15 ++++++++++++++-
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/python/sglang/srt/environ.py b/python/sglang/srt/environ.py
index 46e9c70d..d928c9de 100644
--- a/python/sglang/srt/environ.py
+++ b/python/sglang/srt/environ.py
@@ -316,6 +316,9 @@ class Envs:
     # sizes the KV pool. Cap its resident set; 0 disables the trim.
     SGLANG_QWEN4_PLE_FILE_RSS_BUDGET_GB = EnvFloat(8.0)
     SGLANG_QWEN4_PLE_FILE_RSS_INTERVAL_S = EnvFloat(30.0)
+    # Pack independent 64-key QSA index groups into each decode CTA.
+    # Zero selects the B200 row-count heuristic; a positive value forces it.
+    SGLANG_QSA_MQA_GROUPS_PER_CTA = EnvInt(0)
     SGLANG_PREFETCH_BLOCK_SIZE_MB = EnvInt(16)
     SGLANG_GEMMA_OUT_OF_PLACE_POSITION_MUTATION = EnvBool(False)
     SGLANG_ENABLE_WEIGHT_LOADER_V2 = EnvBool(False)
diff --git a/python/sglang/srt/layers/attention/qsa/mqa.py b/python/sglang/srt/layers/attention/qsa/mqa.py
index 6446ed14..b041fd5c 100644
--- a/python/sglang/srt/layers/attention/qsa/mqa.py
+++ b/python/sglang/srt/layers/attention/qsa/mqa.py
@@ -6,6 +6,8 @@ from typing import Optional
 
 import torch
 
+from sglang.srt.environ import envs
+
 try:
     import flashinfer.comm  # noqa: F401
 except ImportError:
@@ -362,8 +364,19 @@ def tilelang_qsa_mqa_decode(
             ],
             dim=1,
         )
+    groups_per_cta = envs.SGLANG_QSA_MQA_GROUPS_PER_CTA.get()
+    if groups_per_cta < 0:
+        raise ValueError(
+            "SGLANG_QSA_MQA_GROUPS_PER_CTA must be zero (auto) or positive"
+        )
+    if groups_per_cta == 0:
+        rows = q.shape[0]
+        groups_per_cta = 1 if rows <= 8 else 2 if rows <= 24 else 4
     _tilelang_qsa_mqa_decode_kernel(
-        heads=kernel_heads, head_dim=head_dim, page_size=page_size
+        heads=kernel_heads,
+        head_dim=head_dim,
+        page_size=page_size,
+        groups_per_cta=groups_per_cta,
     )(
         q_kernel.unsqueeze(1).contiguous(),
         k_cache.to(torch.bfloat16).contiguous(),
