+            head_dim=head_dim,
+            page_size=page_size,
+            queries_per_request=verify_queries_per_request,
+            groups_per_cta=groups_per_cta,
+        )(q_kernel.contiguous().view(-1, head_dim), *kernel_args)
+    else:
+        _tilelang_qsa_mqa_decode_kernel(
+            heads=kernel_heads,
+            head_dim=head_dim,
+            page_size=page_size,
+            groups_per_cta=groups_per_cta,
+        )(q_kernel.unsqueeze(1).contiguous(), *kernel_args)
     return logits
 
 
