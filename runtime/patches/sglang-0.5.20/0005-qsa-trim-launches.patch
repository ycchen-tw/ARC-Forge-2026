Subject: [PATCH 5/7] arc: 0011-qsa-trim-launches

---
 .../jit/csrc/elementwise/fast_topk.cuh        | 46 ++++++++++++++++++-
 .../kernels/ops/elementwise/fast_topk.py      | 17 +++++--
 python/sglang/srt/layers/attention/qsa/mqa.py | 25 +++++++---
 .../srt/layers/attention/qsa/qsa_indexer.py   |  4 +-
 4 files changed, 80 insertions(+), 12 deletions(-)

diff --git a/python/sglang/kernels/jit/csrc/elementwise/fast_topk.cuh b/python/sglang/kernels/jit/csrc/elementwise/fast_topk.cuh
index b30f4636..11b1f82b 100644
--- a/python/sglang/kernels/jit/csrc/elementwise/fast_topk.cuh
+++ b/python/sglang/kernels/jit/csrc/elementwise/fast_topk.cuh
@@ -217,7 +217,9 @@ __global__ __launch_bounds__(fast_topk_detail::kThreadsPerBlock) void fast_topk_
   device::PDLWaitPrimary<kUsePDL>();
 
   const auto bid = static_cast<uint64_t>(blockIdx.x);
-  const auto row_start = params.row_starts[bid];
+  // run_zero_starts() passes a null row_starts instead of allocating and filling a
+  // per-call zeros tensor; v0.5.20 dropped this guard, so restore it here.
+  const auto row_start = params.row_starts == nullptr ? 0 : params.row_starts[bid];
   const auto length = params.lengths[bid];
   const auto indice = params.indices + bid * kTopK;
   const auto score = params.input + bid * params.input_stride;
@@ -286,6 +288,48 @@ struct FastTopKKernel {
     LaunchKernel(num_rows, fast_topk_detail::kThreadsPerBlock, device.unwrap(), fast_topk_detail::kSmemBytes)
         .enable_pdl(kUsePDL)(kernel, params);
   }
+
+  static void
+  run_zero_starts(const tvm::ffi::TensorView score,
+                  const tvm::ffi::TensorView indices,
+                  const tvm::ffi::TensorView lengths) {
+    using namespace host;
+    auto B = SymbolicSize{"batch"};
+    auto L = SymbolicSize{"length"};
+    auto S = SymbolicSize{"input_stride"};
+    auto device = SymbolicDevice{};
+    device.set_options<kDLCUDA>();
+
+    TensorMatcher({B, L})  // score
+        .with_strides({S, 1})
+        .with_dtype<fp32_t>()
+        .with_device(device)
+        .verify(score);
+    TensorMatcher({B, kTopK})  // indices
+        .with_dtype<int32_t>()
+        .with_device(device)
+        .verify(indices);
+    TensorMatcher({B})  // lengths
+        .with_dtype<int32_t>()
+        .with_device(device)
+        .verify(lengths);
+
+    const auto params = fast_topk_detail::FastTopKParams{
+        .input = static_cast<const float*>(score.data_ptr()),
+        .row_starts = nullptr,
+        .indices = static_cast<int32_t*>(indices.data_ptr()),
+        .lengths = static_cast<const int32_t*>(lengths.data_ptr()),
+        .input_stride = S.unwrap(),
+    };
+
+    const auto num_rows = static_cast<uint32_t>(B.unwrap());
+    LaunchKernel(
+        num_rows,
+        fast_topk_detail::kThreadsPerBlock,
+        device.unwrap(),
+        fast_topk_detail::kSmemBytes)
+        .enable_pdl(kUsePDL)(kernel, params);
+  }
 };
 
 }  // namespace sglang
diff --git a/python/sglang/kernels/ops/elementwise/fast_topk.py b/python/sglang/kernels/ops/elementwise/fast_topk.py
index 7e8757fc..a63c5e99 100644
--- a/python/sglang/kernels/ops/elementwise/fast_topk.py
+++ b/python/sglang/kernels/ops/elementwise/fast_topk.py
@@ -31,7 +31,13 @@ def _jit_fast_topk_module(topk: int) -> Module:
         "fast_topk",
         *args,
         cuda_files=["elementwise/fast_topk.cuh"],
-        cuda_wrappers=[("fast_topk", f"FastTopKKernel<{args}>::run")],
+        cuda_wrappers=[
+            ("fast_topk", f"FastTopKKernel<{args}>::run"),
+            (
+                "fast_topk_zero_starts",
+                f"FastTopKKernel<{args}>::run_zero_starts",
+            ),
+        ],
     )
 
 
@@ -61,10 +67,13 @@ def fast_topk(
     CUDA int32 tensor [B, topk]
     """
     batch = score.shape[0]
-    if row_starts is None:
-        row_starts = torch.zeros(batch, dtype=torch.int32, device=score.device)
     indices = score.new_empty((batch, topk), dtype=torch.int32)
 
     module = _jit_fast_topk_module(topk)
-    module.fast_topk(score, row_starts, indices, lengths)
+    if row_starts is None:
+        # The CUDA kernel already treats a null pointer as row_start=0. Use a
+        # dedicated wrapper rather than allocate/fill a zeros tensor per call.
+        module.fast_topk_zero_starts(score, indices, lengths)
+    else:
+        module.fast_topk(score, row_starts, indices, lengths)
     return indices
diff --git a/python/sglang/srt/layers/attention/qsa/mqa.py b/python/sglang/srt/layers/attention/qsa/mqa.py
index a5596c4a..4450a975 100644
--- a/python/sglang/srt/layers/attention/qsa/mqa.py
+++ b/python/sglang/srt/layers/attention/qsa/mqa.py
@@ -468,6 +468,7 @@ def tilelang_qsa_mqa_decode(
     max_model_len: int,
     score_scale: Optional[float] = None,
     verify_queries_per_request: Optional[int] = None,
+    fill_invalid_tail: bool = True,
 ) -> torch.Tensor:
     """Validated TileLang paged decode kernel with weights removed."""
 
@@ -480,12 +481,22 @@ def tilelang_qsa_mqa_decode(
             "TileLang QSA decode requires a compressed page size of "
             f"8/16/32/64 (64-row GEMM sub-page packing), got {page_size}"
         )
-    logits = torch.full(
-        (q.shape[0], max_model_len),
-        -float("inf"),
-        dtype=torch.float32,
-        device=q.device,
-    )
+    if fill_invalid_tail:
+        logits = torch.full(
+            (q.shape[0], max_model_len),
+            -float("inf"),
+            dtype=torch.float32,
+            device=q.device,
+        )
+    else:
+        # Internal decode selection passes lengths directly to fast_topk, so
+        # columns outside [0, length) are provably unread. Avoid a full
+        # [rows, max_model_len] fill while preserving the public default.
+        logits = torch.empty(
+            (q.shape[0], max_model_len),
+            dtype=torch.float32,
+            device=q.device,
+        )
     if not q.shape[0] or not max_model_len:
         return logits
     # The validated MMA layout requires N (the Q-head dimension) to be a
@@ -563,6 +574,7 @@ def qsa_mqa_decode(
     max_model_len: int,
     score_scale: Optional[float] = None,
     verify_queries_per_request: Optional[int] = None,
+    fill_invalid_tail: bool = True,
 ) -> torch.Tensor:
     if q.is_cuda and HAS_TILELANG:
         return tilelang_qsa_mqa_decode(
@@ -573,6 +585,7 @@ def qsa_mqa_decode(
             max_model_len,
             score_scale,
             verify_queries_per_request,
+            fill_invalid_tail,
         )
     return torch_qsa_mqa_decode(
         q, k_cache, page_table, context_lens, max_model_len, score_scale
