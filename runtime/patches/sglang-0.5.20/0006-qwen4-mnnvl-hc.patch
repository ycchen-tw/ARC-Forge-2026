+"""Qwen4-only FlashInfer MNNVL all-reduce + HC apply epilogue."""
+
+from __future__ import annotations
+
+import functools
+
+import torch
+
+
+@functools.cache
+def _module():
+    from flashinfer.jit import current_compilation_context, gen_jit_spec
+
+    from sglang.kernels.jit.utils import KERNEL_PATH
+
+    flags = current_compilation_context.get_nvcc_flags_list(supported_major_versions=[10])
+    return gen_jit_spec(
+        "sglang_qwen4_mnnvl_hc",
+        [KERNEL_PATH / "csrc/distributed/qwen4_mnnvl_hc.cu"],
+        extra_cuda_cflags=flags,
+    ).build_and_load()
+
+
+def qwen4_mnnvl_hc_combine(
+    input_: torch.Tensor,
+    residual: torch.Tensor,
+    gate: torch.Tensor,
+    output: torch.Tensor,
+    workspace,
+    *,
+    launch_with_pdl: bool = True,
+) -> None:
+    """Reduce ``input_`` and write ``residual + gate * reduced`` to output.
+
+    The caller owns all rank-invariant eligibility checks. Once this function
+    enters the collective it deliberately has no fallback: swallowing an error
+    on one rank while peers remain in MNNVL would hang or corrupt results.
+    """
+    from flashinfer.comm.trtllm_mnnvl_ar import (
+        MNNVLAllreduceFusionStrategy,
+    )
+
+    strategy = MNNVLAllreduceFusionStrategy.select_strategy(
+        workspace.tp_size,
+        input_.shape[0],
+        input_.shape[1],
+        input_.dtype,
+    )
+    if not workspace.is_buffer_size_sufficient(
+        workspace.tp_size,
+        input_.shape[0],
+        input_.shape[1],
+        input_.dtype,
+        strategy,
+    ):
+        raise ValueError("MNNVL workspace is too small for Qwen4 HC fusion")
+
+    _module().qwen4_mnnvl_hc_combine(
+        input_,
+        workspace.mc_ptr,
+        workspace.uc_ptrs_dev,
+        workspace.uc_ptr_local,
+        workspace.buffer_flags,
+        workspace.tp_size,
+        workspace.rank,
+        launch_with_pdl,
+        strategy == MNNVLAllreduceFusionStrategy.ONESHOT,
+        residual,
+        gate,
+        output,
+    )
+
+
+def compile_qwen4_mnnvl_hc() -> None:
+    """Warm the isolated JIT module before CUDA-graph capture."""
+    _module()
diff --git a/python/sglang/kernels/ops/elementwise/hc_gate.py b/python/sglang/kernels/ops/elementwise/hc_gate.py
new file mode 100644
index 00000000..977df41b
--- /dev/null
+++ b/python/sglang/kernels/ops/elementwise/hc_gate.py
@@ -0,0 +1,54 @@
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Optional
+
+import torch
+
+from sglang.kernels.jit.utils import (
+    cache_once,
+    is_arch_support_pdl,
+    load_jit,
+    make_cpp_args,
+)
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+
+@cache_once
+def _jit_hc_gate_module(hc_count: int, hidden_size: int, dtype: torch.dtype) -> Module:
+    if dtype not in (torch.bfloat16, torch.float16):
+        raise RuntimeError(f"HC gate only supports BF16/FP16, got {dtype}")
+    if (hc_count * hidden_size) % (256 * 8) != 0:
+        raise RuntimeError("HC gate row must be divisible by 256 * 8")
+    args = make_cpp_args(hc_count, hidden_size, is_arch_support_pdl(), dtype)
+    return load_jit(
+        "hc_gate",
+        *args,
+        cuda_files=["elementwise/hc_gate.cuh"],
+        cuda_wrappers=[("hc_gate", f"HcGateKernel<{args}>::run")],
+    )
+
+
+def hc_gate(
+    normed_residual: torch.Tensor,
+    inject_weight: torch.Tensor,
+    hc_count: int,
+    hidden_size: int,
+    out: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    normed = normed_residual.reshape(-1, hc_count * hidden_size)
+    if out is None:
+        out = torch.empty(
+            (normed.shape[0], hc_count),
+            dtype=torch.float32,
+            device=normed.device,
+        )
+    else:
+        out = out.reshape(normed.shape[0], hc_count)
+    _jit_hc_gate_module(hc_count, hidden_size, normed.dtype).hc_gate(normed, inject_weight, out)
+    return out
+
+
+def compile_hc_gate(hc_count: int, hidden_size: int, dtype: torch.dtype) -> None:
+    _jit_hc_gate_module(hc_count, hidden_size, dtype)
