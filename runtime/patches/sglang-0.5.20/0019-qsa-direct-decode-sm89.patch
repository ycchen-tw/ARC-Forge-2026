+        k,
+        v,
+        req_to_token,
+        req_indices,
+        indices,
+        seq_lens,
+        out,
+        scale,
+        _unit_scale(k_scale),
+        _unit_scale(v_scale),
+        indices.shape[1],
+        q.stride(0),
+        q.stride(1),
+        q.stride(2),
+        k.stride(0),
+        k.stride(1),
+        k.stride(2),
+        v.stride(0),
+        v.stride(1),
+        v.stride(2),
+        req_to_token.stride(0),
+        indices.stride(0),
+        out.stride(0),
+        out.stride(1),
+        out.stride(2),
+        GROUP_SIZE=group_size,
+        BLOCK_M=block_m,
+        BLOCK_N=block_n,
+        HEAD_DIM=head_dim,
+        KV_IS_FP8=kv_is_fp8,
+        num_warps=warps,
+        num_stages=stages,
+    )
+    return out
