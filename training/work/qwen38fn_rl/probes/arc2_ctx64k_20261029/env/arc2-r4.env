# arc2-r4 (10-29 TW): GPUs 0-5, tp1x3 = replicas on 0/1/2, 3-rank trainer on 3/4/5. From the base (QAD-R INT3), 90 tasks
# (60 eval120fix + 30 audited true_hard, random, ambiguous ones out: build_pool.py), 40k output / 64k context hard caps,
# reward 1 iff every test is right (harness score_mode all_tests), group 24 x 24 groups, lr 1e-4, 128 sessions per replica.
# No held-out (evaluated elsewhere): the template has stream.heldout_every off; RL_HELDOUT_IDS is nominal (configure needs one)
# = the 60 eval120fix tasks not trained on. Tolerances (allow_splits / quarantine / D_cross / routing M) are the template's.
export RL_TEMPLATE=work/qwen38fn_rl/configs/arc2-ctx64k-tp1x3-int3qat.json
export RL_RUN=$ARC_RUNS/qwen38fn_rl/20261029-arc2r4-ctx64k90v2-qadR-tp1x3-b40k-c64k-alltests-g24b576-lr1e-4
export RL_TASKS_DIR=$ARC_DATA/arc2_pools/ctx64k90v2-20261029
export RL_TRAIN_IDS=$ARC_DATA/arc2_pools/ctx64k90v2-20261029.train.txt
export RL_HELDOUT_DIR=$ARC_DATA/arc2_eval120fix/evaluation RL_HELDOUT_IDS=$ARC_DATA/arc2_pools/ctx64k90v2-20261029.untrained_eval120fix.txt
export RL_SERVE_MODEL=/dev/shm/uid-$UID/models/qwen38fn-qadmix-R-int3-gptq
export RL_TRAIN_MODEL=/dev/shm/uid-$UID/models/qwen38fn-qadmix-R-int3-bf16dense
export RL_TOPOLOGY=tp1x3 RL_GPUS=0,1,2,3,4,5 RL_REPLICA_PORT_BASE=30881 RL_CONTROL_PORT=30880 RL_TRAINER_PORT=30890
export RL_UNIT_PREFIX=rl-arc2r4
export RL_SESSIONS=128 RL_RAMP_SECONDS=1200 RL_GROUP_SIZE=24 RL_BATCH=576
export RL_MEMFRAC=0.94   # 0.96 left ~20 MiB beside the 128-session graphs and 768 mamba slots: the fast image processor (GPU, tokenizer process) OOMed on every image request; 0.94 costs ~5% of the KV pool (peak use 0.62)
export RL_STEPS=100 RL_SAVE_EVERY=1 RL_EVAL_EVERY=5   # checkpoint every step (257 MB); merged weights kept every 5 for the evaluators
export RL_ROLLOUT_TEMPERATURE=1.0 RL_ROLLOUT_TOP_P=0.95 RL_ROLLOUT_TOP_K=20
export RL_SERVE_PROFILE=perf-main-fp16-ser-opt-lazyfix-l8-a16-topp RL_LOCK_TARGET=b200-rl-topp-1024 RL_FORK_TREE=$HOME/work/sglang-arc-2-topp
export RL_LR=1e-4 RL_LR_WARMUP_STEPS=2 RL_LOSS_REDUCTION=prompt
export RL_TRAINER_MEMORY_FRACTION=0.97 RL_TRAINER_OFFLOAD_KEEP_GIB=0
export RL_AGENT_RUNTIME=$ARC_RUNS/arc_code/agent-runtime-scipy
