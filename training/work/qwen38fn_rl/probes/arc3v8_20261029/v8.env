# ARC3 RL v8 (docs/plans/arc3_rl_v8_window_note_judge_20261029.md). From ../arc3v7b_20261029/v7b.env except:
#   - dense full FT from QAD-R (user 10-29: lr 3e-6, 16x16), no LoRA init (full mode cannot start from a LoRA checkpoint);
#     checkpoints (~35 GB DCP each) on tmpfs, newest 3 kept
#   - seeds g2seed-v8-20261029: hard 5 / wall 3 / medium 2 per level per epoch (235 ids) from 18 of the 20 v7b games
#     (sc25 and tr87 have no hard / wall / medium level)
#   - each episode stops at the first window change (proxy refuses the first window-1 request); reward note: a clear =
#     clear_reward (official level score, exponential penalty past baseline), a window change at the context threshold =
#     the note judge (Opus 5.5 via API key 2, group-wise, min(tier, clear_reward(used + estimated remaining actions))),
#     an early self window change or any other stop = 0
#   - serving: FP8 KV (v7's profile), 64 sessions x 4 replicas, mamba 6 x 64 (user 10-29 "kv fp8, conc64 * 4");
#     MEMFRAC 0.94 (v7b: at 0.96 the server's GPU video preprocessing hit CUDA OOMs)
#   - note judge: RL_JUDGE_BACKEND api (Opus 5.5, key 2) or codex (gpt-6-astra via the codex CLI); tiers still the plan's
#     initial values -- undecided (user away 10-29: calibration and judge choice pending)
export RL_SERVE_PROFILE=perf-main-fp16-ser-opt-lazyfix-l8-a16-topp-inldev RL_LOCK_TARGET=b200-rl-topp-inldev-1026
export RL_FORK_TREE=$HOME/work/sglang-arc-2-topp
export RL_DFLASH_DIR=$ARC_RUNS/qwen38fn_rl/dflash-rollout/drafter/planb-l8-s25562/deploy-fp8
export RL_SERVE_MODEL=/dev/shm/uid-$UID/models/qwen38fn-qadR1000-int3-gptq
export RL_TRAIN_MODEL=/dev/shm/uid-$UID/models/qwen38fn-qadR1000-int3-bf16dense
export RL_TEMPLATE=work/qwen38fn_rl/configs/arc3-g2seed-v7.json
export RL_TASKS_DIR=$ARC_DATA/arc3_levels/g2seed-v8-20261029
export RL_TOPOLOGY=tp1x4 RL_GPUS=0,1,2,3,4,5,6,7
export RL_GROUP_SIZE=16 RL_BATCH=256 RL_SESSIONS=64 RL_MAMBA_SLOTS=384 RL_MEMFRAC=0.94 RL_RAMP_SECONDS=600
export RL_OUTPUT_BUDGET=300000 RL_CONTEXT_LIMIT=none RL_WINDOW_CHANGE=1 RL_STOP_AFTER_FIRST_WINDOW=1
export RL_SEED_NOTE_DONE=1 RL_PACKET_LEVEL_DOCS=latest
export RL_AGENT_RUNTIME=$ARC_RUNS/arc_code/agent-runtime-scipy
export RL_ROLLOUT_TEMPERATURE=1.0 RL_ROLLOUT_TOP_P=0.95 RL_ROLLOUT_TOP_K=20
export RL_TRAINER_TRAINABLE=full RL_TRAINER_CHECKPOINT_STORE=/dev/shm/uid-$UID/rl-ckpt/arc3v8 RL_TRAINER_KEEP_CHECKPOINTS=3
export RL_LR=3e-6 RL_LR_WARMUP_STEPS=2 RL_LOSS_REDUCTION=prompt RL_ALGO=mis
export RL_ARC3_REWARD=note RL_JUDGE_BACKEND=${RL_JUDGE_BACKEND:?api or codex} \
       RL_JUDGE_MODEL=${RL_JUDGE_MODEL:?claude-opus-5-5 (api) or gpt-6-astra (codex)} RL_JUDGE_EFFORT=${RL_JUDGE_EFFORT:?e.g. high / medium}
export RL_JUDGE_PYTHON=$ARC_DATA/venvs/arc3-judge/bin/python
[ "$RL_JUDGE_BACKEND" != api ] || export RL_JUDGE_ENV_FILE=$HOME/work/arc-forge/.env    # api only (key 2); codex uses ~/.codex
# one backend request <= 1800 s (measured 10-29: astra medium 2-7 min per whole group incl. 2-3 passes, xhigh ~5 min per
# pass on 8 notes); one judge attempt: configure derives the bound (arcforge.arc3_note.judge_attempt_seconds, x1.1 + 600 s:
# api (3 x 3 x 3 x 1800 + 1800 overload budget + 5400) -> 61980 s, codex 3 x 3 x 1800 -> 18420 s); codex: the user's
# ~/.codex login (no CODEX_HOME), codex exec --ignore-user-config with an explicit 800k / 600k context, binary pinned
export RL_JUDGE_CONCURRENCY=16 RL_JUDGE_CALL_TIMEOUT_SECONDS=1800
export RL_STEPS=100 RL_SAVE_EVERY=1 RL_EVAL_EVERY=5
export RL_TRAINER_FAST_KERNELS=all,qsa_union RL_TRAINER_DENSE_QAT_GEMM=cutlass RL_TRAINER_QSA_INDEXER=bf16 RL_TRAINER_OFFLOAD_KEEP_GIB=8
export RL_MIN_FREE_GB=70 RL_HARD_MIN_FREE_GB=22 RL_PREPARE_MAX_GB=64 RL_PREPARE_RESERVE_GB=3 RL_DISK_FLOOR_GIB=22
export RL_PREPARE_MEDIA=cpu-exact
